# /etc/smm/smm.env  (chmod 600, owned by root; read by the systemd services and cron jobs)
SMM_ENV=production
SMM_DATABASE_URL=sqlite:////var/lib/smm/smm.db
SMM_SECRET_KEY=__GENERATED__
SMM_TOKEN_ENCRYPTION_KEY=__GENERATED__

# The first admin, created at startup if no such user exists. Change the password after signing in.
SMM_ADMIN_EMAIL=__ADMIN_EMAIL__
SMM_ADMIN_PASSWORD=__GENERATED__
SMM_ALLOW_REGISTRATION=false

# Same-origin deployment: the dashboard and the API are both served from this host (the API under /api)
SMM_PUBLIC_API_URL=https://authority.thegrowthstacker.in/api
SMM_DASHBOARD_URL=https://authority.thegrowthstacker.in
SMM_CORS_ORIGINS=https://authority.thegrowthstacker.in

# Optional: AI features (drafting, scoring, quick replies, brief suggestions). Without a key they return 503.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: publishing. Register https://authority.thegrowthstacker.in/api/integrations/<linkedin|x>/callback with each platform.
# SMM_LINKEDIN_CLIENT_ID=
# SMM_LINKEDIN_CLIENT_SECRET=
# SMM_X_CLIENT_ID=
# SMM_X_CLIENT_SECRET=
