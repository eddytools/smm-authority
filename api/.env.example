# Copy to .env and adjust. All variables use the SMM_ prefix.
SMM_ENV=development
SMM_DATABASE_URL=sqlite:///./smm.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SMM_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
SMM_ACCESS_TOKEN_MINUTES=60
# Comma-separated list of dashboard origins allowed by CORS
SMM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Bootstrap admin, created at startup if it does not exist yet
SMM_ADMIN_EMAIL=admin@example.com
SMM_ADMIN_PASSWORD=change-me-now
SMM_ALLOW_REGISTRATION=true

# Optional AI suggestions (the app works without them; the endpoint returns 503 if no key is set)
# ANTHROPIC_API_KEY=sk-ant-...
# SMM_AI_MODEL: defaults to claude-opus-5-5 for Anthropic; REQUIRED for OpenAI / Gemini / compatible servers
# SMM_AI_PROVIDER=auto            # auto | anthropic | openai | gemini  (auto = first key found)
# OPENAI_API_KEY=sk-...
# SMM_OPENAI_BASE_URL=https://api.openai.com/v1   # or Groq, Together, OpenRouter, Mistral, DeepSeek, Ollama (http://localhost:11434/v1) ...
# GEMINI_API_KEY=...
# SMM_AI_MODEL=your-model-id
# Max AI requests per non-admin user per rolling 24h
SMM_AI_DAILY_LIMIT_PER_USER=20

# Trend feed
SMM_FETCH_USER_AGENT=smm-authority/0.1 (+https://github.com/eddytools/smm-authority)
SMM_FEED_RETENTION_DAYS=30
SMM_REFRESH_MIN_INTERVAL_SECONDS=60
SMM_AI_SCORE_BATCH=20

# Publishing to LinkedIn / X (optional). Needs an encryption key; scripts/dev.sh generates one for local use:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SMM_TOKEN_ENCRYPTION_KEY=
# Public address of this API, used for the OAuth redirect URI (register <this>/integrations/<platform>/callback with the platform)
SMM_PUBLIC_API_URL=http://localhost:8000
SMM_DASHBOARD_URL=http://localhost:5173
# SMM_LINKEDIN_CLIENT_ID=
# SMM_LINKEDIN_CLIENT_SECRET=
# LinkedIn versions its API by month and retires old versions: confirm a current YYYYMM value in LinkedIn's docs
# SMM_LINKEDIN_API_VERSION=202609
# SMM_X_CLIENT_ID=
# SMM_X_CLIENT_SECRET=
