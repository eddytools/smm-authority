# Copy to .env and adjust. All variables use the SMM_ prefix.
SMM_ENV=development
SMM_DATABASE_URL=sqlite:///./smm.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SMM_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
SMM_ACCESS_TOKEN_MINUTES=60
# Comma-separated list of dashboard origins allowed by CORS
SMM_CORS_ORIGINS=http://localhost:5173
# Bootstrap admin, created at startup if it does not exist yet
SMM_ADMIN_EMAIL=admin@example.com
SMM_ADMIN_PASSWORD=change-me-now
SMM_ALLOW_REGISTRATION=true

# Optional AI suggestions (the app works without them; the endpoint returns 503 if no key is set)
# ANTHROPIC_API_KEY=sk-ant-...
SMM_AI_MODEL=claude-opus-5-5
# Max AI requests per non-admin user per rolling 24h
SMM_AI_DAILY_LIMIT_PER_USER=20

# Trend feed
SMM_FETCH_USER_AGENT=smm-authority/0.1 (+https://github.com/eddytools/smm-authority)
SMM_FEED_RETENTION_DAYS=30
SMM_REFRESH_MIN_INTERVAL_SECONDS=60
SMM_AI_SCORE_BATCH=20
